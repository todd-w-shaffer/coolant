#!/bin/bash
# coolant — the machine-wide work queue's door.
#
#   coolant run --class <name> -- <command...>   run through the queue
#   coolant queue [--json]                        show the horizon
#
# The queue itself lives in thermo (`thermo run`, `thermo queue`); this
# shim only finds a thermo that has the door and execs it. A thermo
# has the door when it answers `--door-version` with the protocol this
# shim speaks. The probe is a flag so that a thermo without the door
# rejects it and exits at once; a bare word would start its dashboard.
#
# Search order: $COOLANT_THERMO alone when set (explicit wins, no
# fallback); otherwise the checkout's bin/thermo beside this script
# (resolved through symlinks, so ~/.local/bin/coolant works), then
# `thermo` on PATH.
#
# With no such thermo, `run` warns once and execs the command unqueued:
# a job never fails because the queue is missing. `queue` has nothing to
# show and exits 1.
#
# Leading NAME=value words after `--` set the command's environment, as
# env(1) does. Exit status: the command's own, or 64 for a malformed call.

PROTOCOL=1

usage() {
  echo "usage: coolant run --class <name> -- <command...>" >&2
  echo "       coolant queue [--json]" >&2
  exit 64
}

# Directory of the real file behind this script, following symlinks.
# bash 3.2 has no `readlink -f`, so walk the chain by hand.
self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  case "$src" in */*) ;; *) src="./$src" ;; esac
  while [ -L "$src" ]; do
    dir="$(cd -P "${src%/*}" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "${src%/*}" && pwd
}

has_door() {
  [ -x "$1" ] && [ "$("$1" --door-version 2>/dev/null)" = "$PROTOCOL" ]
}

[ $# -ge 1 ] || usage
verb="$1"
case "$verb" in
  run|queue) ;;
  *) usage ;;
esac

# The thermo binaries to try, in order, one per line.
candidates() {
  if [ -n "${COOLANT_THERMO:-}" ]; then
    printf '%s\n' "$COOLANT_THERMO"
    return
  fi
  printf '%s\n' "$(self_dir)/../bin/thermo"
  command -v thermo 2>/dev/null
}

# Sets $thermo to the first candidate with the door, and $stale to the
# first one that runs but predates it (so the warning can say "upgrade"
# rather than "install").
thermo="" stale=""
while IFS= read -r candidate; do
  [ -n "$candidate" ] && [ -x "$candidate" ] || continue
  if has_door "$candidate"; then
    thermo="$candidate"
    break
  fi
  [ -n "$stale" ] || stale="$candidate"
done <<EOF_CANDIDATES
$(candidates)
EOF_CANDIDATES

if [ -n "$stale" ]; then
  why="$stale predates the queue door (run \`thermo upgrade\`)"
else
  why="no thermo with the queue door found (set COOLANT_THERMO, or install thermo)"
fi

if [ -n "$thermo" ]; then
  exec "$thermo" "$@"
fi

if [ "$verb" = queue ]; then
  echo "coolant: $why" >&2
  exit 1
fi

# Degrade: run the command after `--`, unqueued.
shift
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  shift
done
[ "${1:-}" = "--" ] || usage
shift
[ $# -ge 1 ] || usage
echo "coolant: $why; running unqueued" >&2
# env, so leading NAME=value words apply as they do through thermo.
exec env "$@"
