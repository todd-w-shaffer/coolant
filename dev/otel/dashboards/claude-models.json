{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "id": 500,
      "title": "Cost by Model",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sort_desc(sum by (model) (claude_code_cost_usage_USD_total))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "palette-classic-by-name" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*opus.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ca9ee6", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*sonnet.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#babbf1", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*haiku.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#81c8be", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*claude-3.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f4b8e4", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 501,
      "title": "Tokens by Model",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sort_desc(sum by (model) (claude_code_token_usage_tokens_total))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic-by-name" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*opus.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ca9ee6", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*sonnet.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#babbf1", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*haiku.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#81c8be", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*claude-3.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f4b8e4", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 502,
      "title": "Share of Spend",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum by (model) (claude_code_cost_usage_USD_total)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic-by-name" }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*opus.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ca9ee6", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*sonnet.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#babbf1", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*haiku.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#81c8be", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*claude-3.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f4b8e4", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 510,
      "title": "Cost per Line by Model",
      "description": "Which model delivers the best dollar-per-line ratio? Lower = better value.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sort(sum by (model) (claude_code_cost_usage_USD_total) / sum by (model) (claude_code_lines_of_code_count_total{type=\"added\"}))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.05 },
              { "color": "#e78284", "value": 0.20 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 511,
      "title": "Tokens per Line by Model",
      "description": "How many tokens does each model consume per line it ships? Lower = more efficient.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sort(sum by (model) (claude_code_token_usage_tokens_total{type=~\"input|cacheRead\"}) / sum by (model) (claude_code_lines_of_code_count_total{type=\"added\"}))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 520,
      "title": "Cache Hit Rate by Model",
      "description": "Which model benefits most from caching in your workload",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sort_desc(sum by (model) (claude_code_token_usage_tokens_total{type=\"cacheRead\"}) / (sum by (model) (claude_code_token_usage_tokens_total{type=\"cacheRead\"}) + sum by (model) (claude_code_token_usage_tokens_total{type=\"input\"})))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 521,
      "title": "Output/Input Ratio by Model",
      "description": "How much does each model generate per token consumed? High = more output. Low = heavy context consumption.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sort_desc(sum by (model) (claude_code_token_usage_tokens_total{type=\"output\"}) / sum by (model) (claude_code_token_usage_tokens_total{type=~\"input|cacheRead\"}))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 530,
      "title": "Cost Over Time by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total[5m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 0,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisBorderShow": false
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*opus.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ca9ee6", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*sonnet.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#babbf1", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*haiku.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#81c8be", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*claude-3.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f4b8e4", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 531,
      "title": "Token Rate by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum by (model) (rate(claude_code_token_usage_tokens_total[5m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*opus.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ca9ee6", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*sonnet.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#babbf1", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*haiku.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#81c8be", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": ".*claude-3.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f4b8e4", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 540,
      "title": "Model Mix Comparison",
      "description": "Side-by-side breakdown: cost, tokens, lines, and sessions per model",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum by (model) (claude_code_cost_usage_USD_total)",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (model) (claude_code_token_usage_tokens_total)",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (model) (claude_code_lines_of_code_count_total{type=\"added\"})",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "expr": "count by (model) (count by (model, session_id) (claude_code_cost_usage_USD_total))",
          "legendFormat": "",
          "refId": "D",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Cost" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Tokens" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Lines" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sessions" },
            "properties": [
              { "id": "unit", "value": "short" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Cost", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "model", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "indexByName": {
              "model": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "model": "Model",
              "Value #A": "Cost",
              "Value #B": "Tokens",
              "Value #C": "Lines",
              "Value #D": "Sessions"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus" }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["claude-code", "coolant", "models"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code Models",
  "uid": "coolant-models",
  "version": 1
}
