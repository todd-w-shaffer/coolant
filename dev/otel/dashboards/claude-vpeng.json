{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Team Productivity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Team Throughput",
      "description": "Team-wide output token generation rate — collective 'writing speed' across all active sessions.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"output\"}[5m])) * 60",
          "legendFormat": "tokens/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ca9ee6", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#ca9ee6", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 11,
      "title": "Net Lines Shipped (7d)",
      "description": "Honest codebase growth over the last 7 days — added minus removed, churn doesn't count.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_lines_of_code_count_total{type=\"added\"}[7d])) - sum(increase(claude_code_lines_of_code_count_total{type=\"removed\"}[7d]))",
          "legendFormat": "net lines",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#a6d189", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 12,
      "title": "Team Context Efficiency",
      "description": "Cross-team cache hit rate — leading indicator of codebase consistency and knowledge reuse. High = team reuses context well.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"cacheRead\"}) / (sum(claude_code_token_usage_tokens_total{type=\"cacheRead\"}) + sum(claude_code_token_usage_tokens_total{type=\"input\"}))",
          "legendFormat": "cache hit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#e78284", "value": null },
              { "color": "#e5c890", "value": 0.3 },
              { "color": "#a6d189", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 2,
      "title": "Adoption Signals",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "title": "Active Engineers (7d)",
      "description": "Distinct engineers who touched Claude in the last 7 days.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "count(count by (user_email) (increase(claude_code_cost_usage_USD_total[7d]) > 0))",
          "legendFormat": "engineers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ef9f76", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#ef9f76", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 21,
      "title": "Parallelization Gain",
      "description": "Time-averaged concurrent agent activity over the range (active-seconds ÷ wall-seconds). 0.2 = team is active ~20% of wall time with one agent. 2.0 = two agents running full-time.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 7 },
      "targets": [
        {
          "expr": "sum(rate(claude_code_active_time_seconds_total[7d]))",
          "legendFormat": "avg parallel agents",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "fixedColor": "#8caaee", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8caaee", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 22,
      "title": "Sessions per Engineer",
      "description": "Average sessions launched per engineer — depth of adoption proxy.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "sum(claude_code_session_count_total) / count(count by (user_email) (claude_code_cost_usage_USD_total))",
          "legendFormat": "sessions/eng",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "fixedColor": "#99d1db", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#99d1db", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 23,
      "title": "Agent Sprawl Index",
      "description": "Peak concurrent Claudes per engineer. Rising = productivity gain OR chaos. Investigate outliers.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 7 },
      "targets": [
        {
          "expr": "max_over_time((count(count by (session_id) (rate(claude_code_cost_usage_USD_total[2m]) > 0)))[7d:1m]) / count(count by (user_email) (claude_code_cost_usage_USD_total))",
          "legendFormat": "peak/eng",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 3 },
              { "color": "#e78284", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 3,
      "title": "Adoption Depth",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "title": "Engineer Adoption Depth",
      "description": "Per-engineer usage matrix. Power users top-left. Training opportunities bottom-right.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (user_email) (claude_code_cost_usage_USD_total)",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (user_email) (claude_code_session_count_total)",
          "legendFormat": "",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (user_email) (claude_code_lines_of_code_count_total{type=\"added\"})",
          "legendFormat": "",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (user_email) (claude_code_active_time_seconds_total)",
          "legendFormat": "",
          "refId": "D",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 50 },
              { "color": "#e78284", "value": 200 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Engineer" },
            "properties": [
              { "id": "custom.width", "value": 240 },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Cost" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sessions" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Lines" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Active Seconds" },
            "properties": [
              { "id": "unit", "value": "s" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Cost", "desc": true }],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "user_email", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time": true
            },
            "indexByName": {
              "user_email": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "user_email": "Engineer",
              "Value #A": "Cost",
              "Value #B": "Sessions",
              "Value #C": "Lines",
              "Value #D": "Active Seconds"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 4,
      "title": "Work Character",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 40,
      "title": "Work Profile Shift",
      "description": "Team-wide reasoning-to-generation ratio. Rising = moving up the value chain (more reasoning, less boilerplate). Falling = still using Claude for simple generation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=~\"input|cacheRead\"}[5m])) / sum(rate(claude_code_token_usage_tokens_total{type=\"output\"}[5m]))",
          "legendFormat": "reasoning : generation",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "fixedColor": "#ef9f76", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 41,
      "title": "Team Context Efficiency Over Time",
      "description": "Is cache efficiency degrading in long conversations or across the codebase?",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[5m])) / (sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[5m])) + sum(rate(claude_code_token_usage_tokens_total{type=\"input\"}[5m])))",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": { "fixedColor": "#a6d189", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#e5c890", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "min"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 5,
      "title": "Force Multiplier & Heavy Tails",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 50,
      "title": "Force Multiplier (Lines per Active Hour)",
      "description": "Lines of code shipped per active hour of engagement. Rising trend = team is getting better at wielding Claude.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_lines_of_code_count_total{type=\"added\"}[1d])) / (sum(increase(claude_code_active_time_seconds_total[1d])) / 3600)",
          "legendFormat": "lines/hour",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ca9ee6", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 51,
      "title": "Heavy-Tail Session Audit (Top 10 by Cost)",
      "description": "Top 10 most expensive sessions. 10% of sessions drive 60% of spend — this is where training and process gains live.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "topk(10, sum by (session_id, user_email, model) (claude_code_cost_usage_USD_total))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 5 },
              { "color": "#e78284", "value": 25 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Cost" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Session" },
            "properties": [
              { "id": "custom.width", "value": 140 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Cost", "desc": true }],
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "session_id": 0,
              "user_email": 1,
              "model": 2,
              "Value": 3
            },
            "renameByName": {
              "session_id": "Session",
              "user_email": "Engineer",
              "model": "Model",
              "Value": "Cost"
            }
          }
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 6,
      "title": "Parallelization",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 60,
      "title": "Concurrent Sessions Over Time",
      "description": "Parallelization over time. Spikes = heavy multi-agent days.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 38 },
      "targets": [
        {
          "expr": "count(count by (session_id) (rate(claude_code_cost_usage_USD_total[2m]) > 0))",
          "legendFormat": "concurrent sessions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ca9ee6", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max", "mean"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 61,
      "title": "Velocity by Engineer",
      "description": "Lines shipped per engineer over the last 7 days — adoption depth ranking by actual output.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 38 },
      "targets": [
        {
          "expr": "sort_desc(sum by (user_email) (rate(claude_code_lines_of_code_count_total{type=\"added\"}[7d])) * 604800)",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8caaee", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["claude-code", "coolant", "vpeng"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code — VP Engineering View",
  "uid": "coolant-vpeng",
  "version": 1
}
