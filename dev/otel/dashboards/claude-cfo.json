{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "id": 100,
      "title": "Projected Monthly Run Rate",
      "description": "7-day trailing average daily spend extrapolated to a 30-day month. The number you defend at the budget meeting.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "avg_over_time((sum(increase(claude_code_cost_usage_USD_total[1d])))[7d:1d]) * 30",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 500 },
              { "color": "#e78284", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 101,
      "title": "Month-to-Date Spend",
      "description": "Total list-rate cost incurred over the last 30 days.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[30d]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 102,
      "title": "Cost Burden per Engineer",
      "description": "Total spend divided by number of active engineers.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(claude_code_cost_usage_USD_total) / count(count by (user_email) (claude_code_cost_usage_USD_total))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 200,
      "title": "Budget Burn (vs. $1000/mo hypothetical)",
      "description": "Adjust divisor in panel query to match actual budget.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[30d])) / 1000",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1.5,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.7 },
              { "color": "#e78284", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 201,
      "title": "Capitalizable Output Ratio",
      "description": "Proxy for capitalizable spend — fraction of code output that is net additions (ASC 350-40 relevant).",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 6 },
      "targets": [
        {
          "expr": "sum(claude_code_lines_of_code_count_total{type=\"added\"}) / (sum(claude_code_lines_of_code_count_total{type=\"added\"}) + sum(claude_code_lines_of_code_count_total{type=\"removed\"}))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#e78284", "value": null },
              { "color": "#e5c890", "value": 0.5 },
              { "color": "#a6d189", "value": 0.7 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 202,
      "title": "FTE Equivalent (at $100/hr, 160hr/mo)",
      "description": "At a fully-loaded $100/hr × 160 hours/month, how many incremental engineer-months of output cost are you commanding?",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[30d])) / 16000",
          "legendFormat": "FTEs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8caaee", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 203,
      "title": "Active Engineers",
      "description": "Distinct engineers using Claude over full time range.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 6 },
      "targets": [
        {
          "expr": "count(count by (user_email) (claude_code_cost_usage_USD_total))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ef9f76", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#ef9f76", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 300,
      "title": "Daily Spend Burn Curve",
      "description": "Day-over-day spend. Rising curve = acceleration.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[1d]))",
          "legendFormat": "daily spend",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "fixedColor": "#ef9f76", "mode": "fixed" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "gradientMode": "scheme",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 301,
      "title": "Cumulative Spend vs. Budget Line",
      "description": "Pacing vs. budget. Budget line is hardcoded at $1000 — edit in panel query.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "targets": [
        {
          "expr": "sum(claude_code_cost_usage_USD_total)",
          "legendFormat": "cumulative spend",
          "refId": "A"
        },
        {
          "expr": "vector(1000)",
          "legendFormat": "budget",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cumulative spend" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#8caaee", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "budget" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#e78284", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 400,
      "title": "Cost by Engineer",
      "description": "Who on the team is driving spend.",
      "type": "table",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "sort_desc(sum by (user_email) (claude_code_cost_usage_USD_total))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 100 },
              { "color": "#e78284", "value": 500 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "user_email" },
            "properties": [
              { "id": "custom.width", "value": 240 },
              { "id": "custom.cellOptions", "value": { "type": "auto" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Cost", "desc": true }],
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "user_email": "Engineer", "Value": "Cost" }
          }
        }
      ],
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 401,
      "title": "Cost by Organization",
      "description": "Multi-tenant spend attribution — for orgs with multiple Anthropic accounts.",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 19 },
      "targets": [
        {
          "expr": "sum by (organization_id) (claude_code_cost_usage_USD_total)",
          "legendFormat": "{{organization_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "palette-classic-by-name" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "displayLabels": []
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 500,
      "title": "Model Spend Mix",
      "description": "Which models are driving cost — cheaper model substitution opportunity.",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sort_desc(sum by (model) (claude_code_cost_usage_USD_total))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 501,
      "title": "Cost per Engineer per Day",
      "description": "Average daily Claude burden per engineer — headcount-normalized trend.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 28 },
      "targets": [
        {
          "expr": "avg(sum by (user_email) (increase(claude_code_cost_usage_USD_total[1d])))",
          "legendFormat": "$/engineer/day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "fixedColor": "#ca9ee6", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 502,
      "title": "Projected Annual Spend",
      "description": "Annualized at current pace. The number to put in the budget request.",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 28 },
      "targets": [
        {
          "expr": "avg_over_time((sum(increase(claude_code_cost_usage_USD_total[1d])))[7d:1d]) * 365",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 10000 },
              { "color": "#e78284", "value": 50000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": { "type": "prometheus" }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["claude-code", "coolant", "cfo"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code — CFO View",
  "uid": "coolant-cfo",
  "version": 1
}
