          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.3 },
              { "color": "#e78284", "value": 0.8 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 511,
      "title": "Net Lines Shipped",
      "description": "Added minus removed — honest codebase growth, churn doesn't count",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 35 },
      "targets": [
        {
          "expr": "sum(claude_code_lines_of_code_count_total{type=\"added\"}) - sum(claude_code_lines_of_code_count_total{type=\"removed\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#a6d189", "mode": "fixed" },
