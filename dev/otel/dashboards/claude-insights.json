{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "links": [],
  "panels": [
    {
      "id": 100,
      "title": "Think-to-Ship Ratio",
      "description": "(input + cacheRead tokens) consumed per line of code shipped. High = deep reasoning. Low = rote generation.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "(sum(claude_code_token_usage_tokens_total{type=\"input\"}) + sum(claude_code_token_usage_tokens_total{type=\"cacheRead\"})) / sum(claude_code_lines_of_code_count_total{type=\"added\"})",
          "legendFormat": "tokens/line",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8caaee", "value": null },
              { "color": "#e5c890", "value": 5000 },
              { "color": "#e78284", "value": 20000 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 101,
      "title": "Cost per Line",
      "description": "List-rate dollars per line of code shipped",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(claude_code_cost_usage_USD_total) / sum(claude_code_lines_of_code_count_total{type=\"added\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.05 },
              { "color": "#e78284", "value": 0.20 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 102,
      "title": "Lines per Dollar",
      "description": "Inverse of cost per line — lines shipped for every $1 spent",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(claude_code_lines_of_code_count_total{type=\"added\"}) / sum(claude_code_cost_usage_USD_total)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#e78284", "value": null },
              { "color": "#e5c890", "value": 5 },
              { "color": "#a6d189", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 103,
      "title": "Cost per Active Minute",
      "description": "Burn rate when you're actually engaged (idle time excluded)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(claude_code_cost_usage_USD_total) / (sum(claude_code_active_time_seconds_total) / 60)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.50 },
              { "color": "#e78284", "value": 2.00 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 200,
      "title": "Hottest Sessions (Cost Burn Rate)",
      "description": "Which terminal is burning the most right now — last 5 min",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sort_desc(sum by (session_id) (rate(claude_code_cost_usage_USD_total[5m]))) * 60",
          "legendFormat": "{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null },
              { "color": "#e5c890", "value": 0.10 },
              { "color": "#e78284", "value": 0.50 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 201,
      "title": "Fastest Sessions (Lines/min)",
      "description": "Which terminal is actually shipping code right now",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sort_desc(sum by (session_id) (rate(claude_code_lines_of_code_count_total{type=\"added\"}[5m]))) * 60",
          "legendFormat": "{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8caaee", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 300,
      "title": "Think-to-Ship Ratio Over Time",
      "description": "Rolling ratio — spikes when Claude is reasoning hard, dips during scaffolding/generation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "(sum(rate(claude_code_token_usage_tokens_total{type=\"input\"}[5m])) + sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[5m]))) / sum(rate(claude_code_lines_of_code_count_total{type=\"added\"}[5m]))",
          "legendFormat": "tokens/line",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "fixedColor": "#ef9f76", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 301,
      "title": "Cache Efficiency Over Time",
      "description": "Cache hit rate as a function of time — does it degrade in long conversations?",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[5m])) / (sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[5m])) + sum(rate(claude_code_token_usage_tokens_total{type=\"input\"}[5m])))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": { "fixedColor": "#a6d189", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#e5c890", "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "last"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 400,
      "title": "Cost Rate by Session",
      "description": "Per-session burn rate over time — see when each terminal is active",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (session_id) (rate(claude_code_cost_usage_USD_total[5m])) * 60",
          "legendFormat": "{{session_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 401,
      "title": "Cache Savings Estimate",
      "description": "Running total of cacheRead tokens — at ~10x cheaper than input, this represents real dollar savings vs. no-cache baseline",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"cacheRead\"}) / 1000000 * 13.5",
          "legendFormat": "est. savings",
          "refId": "A"
        },
        {
          "expr": "sum(claude_code_token_usage_tokens_total{type=\"cacheRead\"})",
          "legendFormat": "cached tokens",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "datasource": { "type": "prometheus" }
    },
    {
      "id": 500,
