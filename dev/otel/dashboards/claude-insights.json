    {
      "id": 510,
      "title": "Code Churn Ratio",
      "description": "Lines removed ÷ lines added. High = refactoring/rework. Low = greenfield building. Can exceed 1.0 during heavy refactors.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "sum(claude_code_lines_of_code_count_total{type=\"removed\"}) / sum(claude_code_lines_of_code_count_total{type=\"added\"})",
