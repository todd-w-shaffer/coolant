            "mode": "absolute",
            "steps": [
              { "color": "#a6d189", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto"
