# Built binaries
bin/
/coolant
thermal/thermal

# macOS
.DS_Store

# graphify knowledge graph (rebuilt by post-commit hook)
graphify-out/

# Local OTEL dogfood data (Prometheus TSDB, Grafana state)
dev/otel/data/

# .claude/ runtime state (only hooks/ and settings.json are tracked)
.claude/projects/
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# git worktrees used for parallel/preview work
.worktrees/

# Local-only hooks copied from .git/hooks/ by install-hooks.sh (e.g., graphify)
.githooks/post-commit
.githooks/post-checkout
.githooks/pre-commit

# Symlink to thermal-enterprise TUI specs (private repo, read-side)
docs/.tui-specs

# Scratch dir for enterprise-bound spec drafts (private, write-side).
# Gitignored by design — see CLAUDE.md "Cross-repo spec access."
docs/_drafts/

# Preview/debug tool binaries (go build artifacts, not shipped)
thermal/brailletext
thermal/sparkdebug
thermal/swatch

# Python bytecode (OTEL scripts)
dev/otel/scripts/__pycache__/

# Superpowers brainstorm sessions (private)
.superpowers/

# Archived artifacts — historical, not in use
docs/archive/
scripts/archive/
tests/archive/
thermal/cmd/archive/
